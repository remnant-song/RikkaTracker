<ui:FluentWindow x:Class="RikkaTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RikkaTracker"
        xmlns:vm="clr-namespace:RikkaTracker.ViewModels"
        xmlns:converters="clr-namespace:RikkaTracker.Converters"
        xmlns:views="clr-namespace:RikkaTracker.Views"
        mc:Ignorable="d"
        Title="{DynamicResource StrAppName}" Height="750" Width="1200"
        Icon="assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">
    <Window.Resources>
        <!-- @Author: trae + deepseek-V4-pro -->
        <!-- @Date: 2026-06-22 -->
        <!-- @Desc: 用于导航栏收起/展开状态下切换视图模式显示形态的转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityListViewModel}">
            <views:ActivityListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageStatisticsViewModel}">
            <views:UsageStatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilterSettingsViewModel}">
            <views:FilterSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/assets/app-icon.png" Width="33" Height="33" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource StrAppName}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                x:Name="NavView"
                Grid.Column="0"
                HorizontalAlignment="Left"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="True"
                OpenPaneLength="200">
                
                <ui:NavigationView.PaneHeader>
                    <!-- @Author: trae + deepseek-V4-pro -->
                    <!-- @Date: 2026-06-23 -->
                    <!-- @Desc: 固定高度的容器，保证展开/收起状态下视图模式切换区域高度一致 -->
                    <Grid Height="60">
                        <!-- 展开状态：完整的视图模式下拉框 -->
                        <StackPanel Visibility="{Binding IsPaneOpen, ElementName=NavView, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <ui:TextBlock Text="{DynamicResource StrViewMode}" FontSize="11" Margin="0,0,0,4"
                                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox SelectedValue="{Binding DisplayMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="AppOnly" Content="{DynamicResource StrDisplayModeAppOnly}"/>
                                <ComboBoxItem Tag="WebOnly" Content="{DynamicResource StrDisplayModeWebOnly}"/>
                                <ComboBoxItem Tag="Combined" Content="{DynamicResource StrDisplayModeCombined}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- @Author: trae + deepseek-V4-pro -->
                        <!-- @Date: 2026-06-23 -->
                        <!-- @Desc: 侧边导航栏收起时的紧凑模式区域：图标按钮 + 下方短标签 -->
                        <!--         使用 StackPanel 垂直排列，避免重叠导致按钮无法点击 -->
                        <!--         整体可见性由 InverseBoolToVisibility 根据侧边栏展开状态控制 -->
                        <StackPanel Visibility="{Binding IsPaneOpen, ElementName=NavView, Converter={StaticResource InverseBoolToVisibility}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- @Date: 2026-06-22 -->
                            <!-- @Desc: 图标按钮，点击可在三种显示模式间循环切换 -->
                        <Button Command="{Binding CycleDisplayModeCommand}"
                                Width="36" Height="36"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                ToolTip="{DynamicResource StrViewMode}">
                            <TextBlock Text="{Binding DisplayModeGlyph}" 
                                    FontFamily="{StaticResource SymbolFont}" 
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Button>
                            <!-- @Date: 2026-06-23 -->
                            <!-- @Desc: 图标下方的简短模式标签，跟随 DisplayMode 实时切换 -->
                            <TextBlock Text="{Binding DisplayModeShortLabel}" 
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,8"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrDashboard}"
                        Command="{Binding NavigateToDashboardCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: Home → \uE80F (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE80F;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrActiveApps}"
                        Command="{Binding NavigateToActivityListCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: AppIconDefault → \uECAA (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xECAA;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrTimeline}"
                        Command="{Binding NavigateToStatisticsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: Clock → \uE916 (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE916;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrUsageStatistics}"
                        Command="{Binding NavigateToUsageStatisticsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: DataBarVertical → \uE9F6 (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE86F;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrFilterRules}"
                        Command="{Binding NavigateToFilterSettingsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: Shield → \uEA18 (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xEA18;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrExport}"
                        Command="{Binding NavigateToExportCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: Share → \uF12B (Segoe Fluent Icons，替代旧的 ArrowExportUp) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xF12B;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrSettings}"
                        Command="{Binding NavigateToSettingsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <!-- @Desc: Settings → \uE713 (Segoe Fluent Icons) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE713;" FontSize="20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <ContentPresenter Grid.Column="1" Margin="10" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
