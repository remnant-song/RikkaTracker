<UserControl x:Class="RikkaTracker.Views.UsageStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:RikkaTracker.ViewModels"
             xmlns:local="clr-namespace:RikkaTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:UsageStatisticsViewModel}">
    <UserControl.Resources>
        <!-- @Author: trae + deepseek-V4-pro -->
        <!-- @Date: 2026-06-23 -->
        <!-- @Desc: Segoe Fluent Icons 字体资源，用于 FontIcon 标记扩展 -->
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:EnumMatchToBooleanConverter x:Key="EnumMatchToBooleanConverter"/>
        <local:EnumMatchToVisibilityConverter x:Key="EnumMatchToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:TextBlock Text="{DynamicResource StrUsageStatistics}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

                <!-- 顶部选择栏 -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 维度切换 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <RadioButton Content="{DynamicResource StrByDay}" Style="{StaticResource {x:Type ToggleButton}}" 
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Day}" Margin="0,0,5,0" Padding="15,5"/>
                        <RadioButton Content="{DynamicResource StrByWeek}" Style="{StaticResource {x:Type ToggleButton}}" 
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Week}" Margin="0,0,5,0" Padding="15,5"/>
                        <RadioButton Content="{DynamicResource StrByMonth}" Style="{StaticResource {x:Type ToggleButton}}" 
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Month}" Margin="0,0,5,0" Padding="15,5"/>
                        <RadioButton Content="{DynamicResource StrByYear}" Style="{StaticResource {x:Type ToggleButton}}" 
                                     IsChecked="{Binding CurrentMode, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Year}" Padding="15,5"/>
                    </StackPanel>

                    <!-- 时间段选择 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        
                        <!-- 按天选择器 -->
                        <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" 
                                    Visibility="{Binding CurrentMode, Converter={StaticResource EnumMatchToVisibilityConverter}, ConverterParameter=Day}"/>
                        
                        <!-- 按周选择器 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CurrentMode, Converter={StaticResource EnumMatchToVisibilityConverter}, ConverterParameter=Week}">
                            <!-- @Desc: ChevronLeft → \uE76C (Segoe Fluent Icons) -->
                            <ui:Button Command="{Binding PrevWeekCommand}" Icon="{ui:FontIcon FontFamily={StaticResource SymbolFont}, Glyph=&#xE76C;}" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{Binding SelectedWeekDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                            <!-- @Desc: ChevronRight → \uE76B (Segoe Fluent Icons) -->
                            <ui:Button Command="{Binding NextWeekCommand}" Icon="{ui:FontIcon FontFamily={StaticResource SymbolFont}, Glyph=&#xE76B;}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- 按月选择器 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CurrentMode, Converter={StaticResource EnumMatchToVisibilityConverter}, ConverterParameter=Month}">
                            <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="120" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{DynamicResource StrYear}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding SelectedMonth}" Width="100" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{DynamicResource StrMonth}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 按年选择器 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CurrentMode, Converter={StaticResource EnumMatchToVisibilityConverter}, ConverterParameter=Year}">
                            <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYearOnly}" Width="120" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{DynamicResource StrYear}" VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- 柱状图 -->
                <ui:Card Grid.Row="2" Padding="10" Margin="0,0,0,20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid>
                        <lvc:CartesianChart Series="{Binding Series}" 
                                            XAxes="{Binding XAxes}" 
                                            YAxes="{Binding YAxes}"
                                            MinHeight="200"
                                            Background="Transparent"
                                            DataPointerDown="CartesianChart_DataPointerDown"/>
                        
                        <!-- 加载中遮罩 -->
                        <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- 活动应用排行标题 -->
                <ui:TextBlock Grid.Row="3" Text="{DynamicResource StrActiveApps}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <!-- 活动应用排行 -->
                <ui:Card Grid.Row="4" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="200">
                    <Grid>
                        <ItemsControl Name="LeaderboardList" ItemsSource="{Binding Leaderboard}" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标 -->
                                        <Grid Width="24" Height="24" Margin="0,0,15,0">
                                            <Image Source="{Binding Icon}" Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <!-- @Desc: AppIconDefault → \uECAA (Segoe Fluent Icons) -->
                                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xECAA;" FontSize="24" 
                                                           Visibility="{Binding Icon, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{Binding ProcessName}" FontSize="14" FontWeight="SemiBold"/>
                                            
                                            <!-- 进度条 -->
                                            <Grid Margin="0,5,0,0" Height="6">
                                                <Border Background="{ui:ThemeResource ControlFillColorDefaultBrush}" CornerRadius="3"/>
                                                <Border HorizontalAlignment="Left" Background="{StaticResource BrushPink}" CornerRadius="3">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                            <Binding Path="Percentage"/>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <ui:TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.8"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 空数据提示 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=LeaderboardList, Path=HasItems}" Value="False"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- @Desc: Folder → \uE838 (Segoe Fluent Icons; embedded font lacks \uEC5F Box) -->
                            <ui:FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE838;" FontSize="48" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                            <ui:TextBlock Text="{DynamicResource StrNoData}" FontSize="16" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
