{
    "name": "RikkaTracker Sentry",
    "description": "RikkaTracker web browsing time tracker extension",
    "version": "0.6",
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "id": "rikka-tracker-sentry@remnant-song",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "browser_action": {
        "default_icon": "icons/inactive.png"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "permissions": [
        "tabs",
        "management"
    ]
}
